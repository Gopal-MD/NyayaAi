# --- Secrets (NEVER commit these) ---
**/.env*
**/firebase-service-account.json
**/*.pem
**/*.key

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Node / Next.js ---
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
*.tsbuildinfo
.npm

# --- Data / models (large files) ---
backend/data/chroma_index/
backend/data/hf_cache/
backend/data/bm25_index.pkl
backend/nyayasaathi.db
backend/data/demo_cache/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/settings.json
.idea/
*.swp
*.swo

# --- Logs ---
*.log
logs/
